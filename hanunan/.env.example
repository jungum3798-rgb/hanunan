# 데이터베이스 (docker-compose에서 DB_URL은 자동 주입)
DB_URL=jdbc:postgresql://localhost:5432/hanunan
DB_USERNAME=postgres
DB_PASSWORD=your_password

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hanunan.com/oauth/google/redirect

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://hanunan.com/oauth/kakao/redirect
KAKAO_API_KEY=

# JWT
JWT_SECRET=

# CORS (쉼표로 구분해 여러 오리진 허용 가능)
CORS_ALLOWED_ORIGINS=https://hanunan.com

# 재난 API
DISASTER_API_KEY=
DISASTER_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-00247

# 서버 포트
SERVER_PORT=8081

# AI APIs
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GEMINI_API_KEY=

# 안전 시설 API
AED_API_KEY=
AED_API_URL=http://www.safetydata.go.kr/V2/api/DSSP-IF-00068
SHELTER_API_KEY=
SHELTER_API_URL=https://www.safetydata.go.kr/V2/api/DSSP-IF-10941

# 뉴스 API
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 이미지 업로드 경로
REPORT_IMAGE_DIR=uploads/reports
